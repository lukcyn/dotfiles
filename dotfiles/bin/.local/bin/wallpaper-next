#!/bin/sh

WALL_DIR="$HOME/Pictures/wallpapers"
MONITOR="DP-6"

CURRENT=$(hyprctl hyprpaper listloaded | grep "$MONITOR" | awk -F',' '{print $2}')

NEXT=$(find "$WALL_DIR" -type f | sort | awk -v cur="$CURRENT" '
{
  if (found == 1) { print; exit }
  if ($0 == cur) found=1
}
END {
  if (found != 1) print first
}
NR==1 {first=$0}
')

# fallback if something breaks
[ -z "$NEXT" ] && NEXT=$(find "$WALL_DIR" -type f | shuf -n 1)

hyprctl hyprpaper wallpaper "$MONITOR,$NEXT"
